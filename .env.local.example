# Supabase Configuration (Free tier from supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Resend API Configuration (Free tier from resend.com - 3000 emails/month)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=FreshKeep <onboarding@resend.dev>

# Cron Security Secret (Random 32-char string to protect your cron endpoint)
CRON_SECRET=freshkeep_secret_token_1234567890
